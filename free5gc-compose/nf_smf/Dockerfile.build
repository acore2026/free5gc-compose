FROM golang:1.25.5-trixie AS builder

RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update && apt-get install -y git gcc musl-dev && rm -rf /var/lib/apt/lists/*

ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . ./

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o smf ./cmd/

FROM alpine:3.15

RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories
RUN apk add --no-cache tini

WORKDIR /free5gc
RUN mkdir -p config/ log/ cert/

COPY --from=builder /build/smf ./

VOLUME [ "/free5gc/config" ]
VOLUME [ "/free5gc/cert" ]

EXPOSE 8000

ENTRYPOINT [ "/sbin/tini", "--" ]
CMD [ "./smf" ]
