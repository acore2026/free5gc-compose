+#!/usr/bin/env bash
+set -euo pipefail
+
+BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+RESTORE_ROOT="${1:-/home/core/free5gc-compose-restored}"
+EXTERNAL_CONFIG_ROOT="${2:-/home/core/config-restored}"
+
+echo "[1/5] Loading Docker images from ${BASE_DIR}/images"
+for image_tar in "${BASE_DIR}"/images/*.tar; do
+  [ -e "${image_tar}" ] || continue
+  echo "  docker load -i ${image_tar}"
+  docker load -i "${image_tar}"
+done
+
+echo "[2/5] Restoring compose/config files"
+mkdir -p "${RESTORE_ROOT}" "${EXTERNAL_CONFIG_ROOT}"
+cp -a "${BASE_DIR}/config/free5gc-compose/." "${RESTORE_ROOT}/"
+cp -a "${BASE_DIR}/config/external-home-core-config/." "${EXTERNAL_CONFIG_ROOT}/"
+
+echo "[3/5] Starting MongoDB first"
+cd "${RESTORE_ROOT}"
+if docker compose version >/dev/null 2>&1; then
+  COMPOSE=(docker compose)
+else
+  COMPOSE=(docker-compose)
+fi
+"${COMPOSE[@]}" up -d mongodb
+
+echo "[4/5] Restoring free5gc MongoDB database"
+for _ in $(seq 1 30); do
+  if docker exec mongodb mongosh --eval 'db.runCommand({ ping: 1 })' >/dev/null 2>&1 || \
+     docker exec mongodb mongo --eval 'db.runCommand({ ping: 1 })' >/dev/null 2>&1; then
+    break
+  fi
+  sleep 2
+done
+docker cp "${BASE_DIR}/mongo/free5gc.archive.gz" mongodb:/tmp/free5gc.archive.gz
+docker exec mongodb mongorestore --drop --gzip --archive=/tmp/free5gc.archive.gz --nsInclude='free5gc.*'
+docker exec mongodb rm -f /tmp/free5gc.archive.gz
+
+echo "[5/5] Starting core network containers"
+"${COMPOSE[@]}" up -d
+
+echo
+echo "Restore complete."
+echo "Compose/config restored to: ${RESTORE_ROOT}"
+echo "External UE/RAN config restored to: ${EXTERNAL_CONFIG_ROOT}"
+echo "If your scripts expect /home/core/config, copy or symlink ${EXTERNAL_CONFIG_ROOT} after checking existing files."
*** Add File: /home/success5GC/README_RESTORE.md
+# success5GC 备份与恢复说明
+
+这个目录保存了当前这套 free5GC 核心网的可恢复快照。
+
+## 内容
+
+- `images/`: 当前核心网相关 Docker 镜像 tar 包。
+- `config/free5gc-compose/`: compose 文件、NF 配置、证书、脚本、UERANSIM 配置。
+- `config/external-home-core-config/`: 当前 `/home/core/config` 里的外部 UE/RAN 配置。
+- `mongo/free5gc.archive.gz`: MongoDB 中 `free5gc` 数据库导出，包含 UE 订阅和核心网数据。
+- `metadata/`: 当前容器、镜像、git 状态、UPF 源码 commit、校验和等记录。
+- `restore.sh`: 一键加载镜像、恢复配置、恢复 MongoDB、启动核心网。
+
+## 恢复
+
+默认恢复到 `/home/core/free5gc-compose-restored`，外部配置恢复到 `/home/core/config-restored`：
+
+```bash
+/home/success5GC/restore.sh
+```
+
+也可以指定恢复目录：
+
+```bash
+/home/success5GC/restore.sh /home/core/free5gc-compose-restored /home/core/config-restored
+```
+
+恢复脚本不会覆盖现有 `/home/core/config`，避免误删当前配置。确认无冲突后，可以手动替换或建立软链接。
+
+## 校验
+
+```bash
+cd /home/success5GC
+sha256sum -c metadata/checksums.sha256
+```
+
+## 备注
+
+这份快照保存的是当前正在运行核心网使用的镜像和数据库状态，不包含 Docker 构建缓存或失败构建中间镜像。
*** End Patch
